# Copy to `.env.local` and fill in. Restart the dev server after.
#
# SECURITY: there is no server. Every value here is compiled into the shipped
# bundle and is extractable by anyone who unzips the .crx. Treat it as PUBLIC.
# These are rate-limit identifiers, not secrets — restrict them by allowed
# origin in each provider's dashboard and rotate on abuse.
# NEVER put a password, seed phrase, or private key here.

# --- Ethereum ---------------------------------------------------------------
# The RPC host is not configurable here; endpoints live in
# src/core/network/chain.ts and this key is appended to them.
VITE_ALCHEMY_API_KEY=your_alchemy_api_key

# Chain a fresh install starts on. Unset means Sepolia. 1 = mainnet.
VITE_EVM_CHAIN_ID=11155111

# --- Prices (optional) ------------------------------------------------------
# The URL is the on/off switch. Unset means balances still show, with no fiat.
VITE_COINGECKO_API_URL=https://api.coingecko.com/api/v3
VITE_COINGECKO_API_KEY=CG-your_coingecko_api_key

# --- Bitcoin (watch-only) ---------------------------------------------------
# This URL is the on/off switch for the whole feature. Unset it and Bitcoin
# disappears, including any request to a third-party indexer — which matters,
# because reading a balance is a gap scan that shows this host the user's
# addresses and IP.
#
# Esplora REST base, https only, and it MUST serve the network below. A
# mismatched pair does not fail loudly: the wrong chain's host answers every
# address "unused" and the wallet reports a confident zero. Only one direction
# is machine-checked. See src/platform/indexer/indexerOverrides.ts.
VITE_BITCOIN_INDEXER_URL=https://blockstream.info/signet/api

# mainnet | signet | testnet4. Unset means signet. Set-but-unrecognised turns
# Bitcoin OFF rather than falling back, so a typo cannot pass testnet coins off
# as real ones.
VITE_BITCOIN_NETWORK=signet

# Optional, one per network — the switch above only configures the network it
# names, and the others fall back to built-in hosts that are not always
# reachable. Same rules as above.
VITE_BITCOIN_INDEXER_URL_MAINNET=https://blockstream.info/api
#VITE_BITCOIN_INDEXER_URL_SIGNET=
# testnet4 left unset on purpose: Blockstream's /testnet/api is testnet3.
#VITE_BITCOIN_INDEXER_URL_TESTNET4=
