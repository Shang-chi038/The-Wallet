{
  "name": "wallet-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run verify:manifest",
    "verify:manifest": "node scripts/verifyBuiltManifest.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "vite-node scripts/smokeTest.ts",
    "screenshot": "node scripts/screenshotPopup.mjs",
    "build:firefox": "npm run build && node scripts/buildFirefox.mjs",
    "lint:firefox": "web-ext lint --source-dir dist-firefox"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/playfair-display": "5.3.0",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0",
    "@scure/bip32": "1.7.0",
    "@scure/bip39": "1.6.0",
    "@scure/btc-signer": "^1.8.0",
    "framer-motion": "12.43.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "viem": "2.55.19",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.7.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/chrome": "0.0.320",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "4.7.0",
    "playwright": "1.62.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  }
}
